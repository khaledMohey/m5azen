{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run db:generate && npm run build:api && npm run build:web",
  "outputDirectory": "apps/web/dist",
  "regions": ["iad1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{apps/api/dist/**,node_modules/.prisma/client/**,node_modules/@libsql/linux-x64-gnu/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
