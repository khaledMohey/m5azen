{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "نظام AK Tech لإدارة المخازن",
  "version": "1.0.0",
  "identifier": "com.m5azen.app",
  "build": {
    "beforeDevCommand": "npm run dev -w @m5azen/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @m5azen/web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "نظام AK Tech لإدارة المخازن",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Arabic", "English"]
      }
    }
  },
  "plugins": {}
}
