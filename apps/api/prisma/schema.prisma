generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  WAREHOUSE
  SALES
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIAL
  PAID
  CANCELLED
}

enum CashDirection {
  IN
  OUT
}

enum PayMethodKind {
  IMMEDIATE
  CHECK
}

enum PriceList {
  RETAIL
  WHOLESALE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CheckDirection {
  IN
  OUT
}

enum CheckStatus {
  PENDING
  CLEARED
  BOUNCED
  CANCELLED
}

enum DocKind {
  QUOTATION
  SALES_ORDER
  PURCHASE_ORDER
}

enum DocStatus {
  DRAFT
  OPEN
  CONVERTED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  fullName     String
  role         Role      @default(SALES)
  permissions  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cashTransactions CashTransaction[]
  salesInvoices    SalesInvoice[]    @relation("SalesCreatedBy")
  purchaseInvoices PurchaseInvoice[] @relation("PurchaseCreatedBy")
  shifts           CashierShift[]
  warehouseLinks   UserWarehouse[]
  periodsClosed    FiscalPeriod[]    @relation("PeriodClosedBy")
  periodLogs       FiscalPeriodLog[] @relation("PeriodLogUser")
  orgNodeId        String?
  orgNode          OrgNode?          @relation(fields: [orgNodeId], references: [id], onDelete: SetNull)
  employee         Employee?
  journalEntries   JournalEntry[]    @relation("JournalCreatedBy")
  accountingAudits AccountingAuditLog[] @relation("AccountingAuditUser")
}

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  location    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockBalances          StockBalance[]
  stockMovements         StockMovement[]
  salesInvoices          SalesInvoice[]
  purchaseInvoices       PurchaseInvoice[]
  salesReturns           SalesReturn[]
  purchaseReturns        PurchaseReturn[]
  replacementReturns     SalesReturn[]       @relation("ReturnReplacementWarehouse")
  oldBatteriesStocked    OldBattery[]        @relation("OldBatteryStockWarehouse")
  oldBatteryReplacements OldBattery[]        @relation("OldBatteryReplacementWarehouse")
  oldBatteryLoaners      OldBattery[]        @relation("OldBatteryLoanerWarehouse")
  transfersFrom          StockTransfer[]     @relation("TransferFrom")
  transfersTo            StockTransfer[]     @relation("TransferTo")
  locations              WarehouseLocation[]
  productLocations       ProductLocation[]
  productWarehouses      ProductWarehouse[]
  customerWarehouses     CustomerWarehouse[]
  supplierWarehouses     SupplierWarehouse[]
  userLinks              UserWarehouse[]
  documents              TradeDocument[]
}

/// حقول اختيارية عامة على الأصناف (ماركة، لون…) — الصنف اللي مش محتاجها يسيبها فاضية
model ProductCustomField {
  id         String    @id @default(cuid())
  name       String    @unique
  label      String
  fieldType  FieldType @default(TEXT)
  options    String?
  isRequired Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  values ProductFieldValue[]
}

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  unit           String   @default("قطعة")
  costPrice      Float    @default(0)
  salePrice      Float    @default(0)
  minStock       Float    @default(0)
  description    String?
  barcode        String?  @unique
  brand          String?
  /// مقاس البطارية (مثل 55 أمبير / 70 أمبير)
  batterySize    String?
  categoryId     String?
  wholesalePrice Float    @default(0)
  packUnit       String?
  packSize       Float    @default(1)
  imageFile      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category               Category?             @relation(fields: [categoryId], references: [id])
  fieldValues            ProductFieldValue[]
  customerPrices         CustomerPrice[]
  locations              ProductLocation[]
  warehouses             ProductWarehouse[]
  documentLines          TradeDocumentLine[]
  stockBalances          StockBalance[]
  stockMovements         StockMovement[]
  salesLines             SalesInvoiceLine[]
  purchaseLines          PurchaseInvoiceLine[]
  salesReturnLines       SalesReturnLine[]
  purchaseReturnLines    PurchaseReturnLine[]
  transferLines          StockTransferLine[]
  replacementReturns     SalesReturn[]         @relation("ReturnReplacementProduct")
  oldBatteries           OldBattery[]          @relation("OldBatteryProduct")
  oldBatteriesStocked    OldBattery[]          @relation("OldBatteryStockProduct")
  oldBatteryReplacements OldBattery[]          @relation("OldBatteryReplacementProduct")
  oldBatteryLoaners      OldBattery[]          @relation("OldBatteryLoanerProduct")
}

/// أصناف مربوطة بمخزن معيّن. لو الصنف مفيهوش صفوف هنا يبقى متاح لكل المخازن.
model ProductWarehouse {
  id          String @id @default(cuid())
  productId   String
  warehouseId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model ProductFieldValue {
  id        String @id @default(cuid())
  productId String
  fieldId   String
  value     String

  product Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  field   ProductCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([productId, fieldId])
}

model StockBalance {
  id          String @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Float  @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
}

model StockMovement {
  id          String            @id @default(cuid())
  warehouseId String
  productId   String
  type        StockMovementType
  quantity    Float
  unitCost    Float             @default(0)
  reference   String?
  note        String?
  createdAt   DateTime          @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
}

model StockTransfer {
  id              String   @id @default(cuid())
  number          String   @unique
  fromWarehouseId String
  toWarehouseId   String
  note            String?
  createdAt       DateTime @default(now())

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]
}

model StockTransferLine {
  id         String @id @default(cuid())
  transferId String
  productId  String
  quantity   Float

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Float    @default(0)
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  payments         Payment[]
  checks           BankCheck[]
  documents        TradeDocument[]     @relation("DocSupplier")
  warehouses       SupplierWarehouse[]
  scrapSales       ScrapSale[]
  oldBatteries     OldBattery[]
  journalLines     JournalLine[]
  openingBalances  AccountOpeningBalance[]
}

model Customer {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  phone          String?
  email          String?
  address        String?
  balance        Float           @default(0)
  creditLimit    Float           @default(0)
  priceList      PriceList       @default(RETAIL)
  notes          String?
  checks         BankCheck[]
  customerPrices CustomerPrice[]
  documents      TradeDocument[] @relation("DocCustomer")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  salesInvoices   SalesInvoice[]
  salesReturns    SalesReturn[]
  receipts        Receipt[]
  warehouses      CustomerWarehouse[]
  oldBatteries    OldBattery[]
  journalLines    JournalLine[]
  openingBalances AccountOpeningBalance[]
}

/// عملاء مربوطين بمخزن. من غير صفوف = ظاهر لكل المخازن.
model CustomerWarehouse {
  id          String @id @default(cuid())
  customerId  String
  warehouseId String

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([customerId, warehouseId])
  @@index([warehouseId])
}

/// موردين مربوطين بمخزن. من غير صفوف = ظاهر لكل المخازن.
model SupplierWarehouse {
  id          String @id @default(cuid())
  supplierId  String
  warehouseId String

  supplier  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([supplierId, warehouseId])
  @@index([warehouseId])
}

model CashAccount {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  accountType String   @default("CASH")
  balance     Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions CashTransaction[]
  payments     Payment[]
  receipts     Receipt[]
  shifts       CashierShift[]
  expenses     Expense[]
  checks       BankCheck[]
  payMethod    PayMethod?
  salesReturns SalesReturn[]
  scrapSales   ScrapSale[]
  glAccount    Account?
}

model PayMethod {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  kind          PayMethodKind @default(IMMEDIATE)
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  cashAccountId String?       @unique
  createdAt     DateTime      @default(now())

  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
}

model CashTransaction {
  id            String        @id @default(cuid())
  accountId     String
  direction     CashDirection
  amount        Float
  description   String
  paymentMethod String        @default("")
  reference     String?
  createdById   String?
  createdAt     DateTime      @default(now())

  account   CashAccount @relation(fields: [accountId], references: [id])
  createdBy User?       @relation(fields: [createdById], references: [id])
}

model SalesInvoice {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String
  warehouseId   String
  status        InvoiceStatus @default(DRAFT)
  invoiceDate   DateTime      @default(now())
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float         @default(0)
  paidAmount    Float         @default(0)
  paymentMethod String        @default("")
  taxRate       Float         @default(0)
  /// بطارية خردة مع الفاتورة (وزن × سعر الكيلو يُضاف للإجمالي)
  hasScrap      Boolean       @default(false)
  scrapKg       Float         @default(0)
  scrapPieces   Float         @default(0)
  scrapPriceKg  Float         @default(0)
  scrapAmount   Float         @default(0)
  /// SCRAP خردة عادية · WARRANTY_SWAP زبون ضمان دفع فرق وخد جديدة
  scrapKind     String        @default("SCRAP")
  shiftId       String?
  notes         String?
  createdById   String?
  /// Monotonic epoch advanced on accepted FIFO cost publish
  cogsEpoch     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer     Customer           @relation(fields: [customerId], references: [id])
  shift        CashierShift?      @relation(fields: [shiftId], references: [id])
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  createdBy    User?              @relation("SalesCreatedBy", fields: [createdById], references: [id])
  lines        SalesInvoiceLine[]
  receipts     Receipt[]
  returns      SalesReturn[]
  oldBatteries OldBattery[]
  cogsDirty    AccountingCogsDirty?
  cogsLock     AccountingCogsLock?

  @@index([invoiceDate])
  @@index([status])
  @@index([customerId])
}

model SalesInvoiceLine {
  id        String @id @default(cuid())
  invoiceId String
  productId String
  quantity  Float
  unitPrice Float
  unitCost  Float  @default(0)
  discount  Float  @default(0)
  total     Float

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
}

model PurchaseInvoice {
  id            String        @id @default(cuid())
  number        String        @unique
  supplierId    String
  warehouseId   String
  status        InvoiceStatus @default(DRAFT)
  invoiceDate   DateTime      @default(now())
  subtotal      Float         @default(0)
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float         @default(0)
  paidAmount    Float         @default(0)
  paymentMethod String        @default("")
  /// قيمة خردة مبيعة لنفس المورد ومخصومة من الفاتورة (الإجمالي بعد خصمها)
  scrapAmount   Float         @default(0)
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier  Supplier              @relation(fields: [supplierId], references: [id])
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  createdBy User?                 @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  lines     PurchaseInvoiceLine[]
  payments  Payment[]
  returns   PurchaseReturn[]
  scrapSale ScrapSale?

  @@index([invoiceDate])
  @@index([status])
  @@index([supplierId])
}

model PurchaseInvoiceLine {
  id          String    @id @default(cuid())
  invoiceId   String
  productId   String
  quantity    Float
  unitCost    Float
  discount    Float     @default(0)
  total       Float
  /// بيانات الشحنة — تختلف مع كل شراء (اختياري)
  batchNumber String?
  expiryDate  DateTime?

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
}

model SalesReturn {
  id                     String   @id @default(cuid())
  number                 String   @unique
  salesInvoiceId         String?
  customerId             String?
  /// اسم عميل اختياري (نص حر)
  customerName           String?
  warehouseId            String
  returnDate             DateTime @default(now())
  total                  Float    @default(0)
  notes                  String?
  /// خردة بالوزن/القطع (ينفع بدون صنف)
  scrapKg                Float    @default(0)
  scrapPieces            Float    @default(0)
  /// استهلاك فلوس اختياري → حركة إيراد على الخزنة
  consumptionAmount      Float    @default(0)
  cashAccountId          String?
  /// استبدال ببطارية جديدة من مخزن آخر
  giveReplacement        Boolean  @default(false)
  replacementProductId   String?
  replacementWarehouseId String?
  replacementQty         Float    @default(0)
  createdAt              DateTime @default(now())

  salesInvoice         SalesInvoice?     @relation(fields: [salesInvoiceId], references: [id])
  customer             Customer?         @relation(fields: [customerId], references: [id])
  warehouse            Warehouse         @relation(fields: [warehouseId], references: [id])
  cashAccount          CashAccount?      @relation(fields: [cashAccountId], references: [id])
  replacementProduct   Product?          @relation("ReturnReplacementProduct", fields: [replacementProductId], references: [id])
  replacementWarehouse Warehouse?        @relation("ReturnReplacementWarehouse", fields: [replacementWarehouseId], references: [id])
  lines                SalesReturnLine[]
  oldBatteries         OldBattery[]
}

model SalesReturnLine {
  id        String @id @default(cuid())
  returnId  String
  productId String
  quantity  Float
  unitPrice Float
  /// تكلفة سطر البيع الأصلي. فاضي للمرتجع غير المربوط بفاتورة.
  unitCost  Float?
  total     Float

  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
}

model PurchaseReturn {
  id                String   @id @default(cuid())
  number            String   @unique
  purchaseInvoiceId String?
  supplierId        String
  warehouseId       String
  returnDate        DateTime @default(now())
  total             Float    @default(0)
  /// استهلاك بندفعه للمورد على المرتجع: BALANCE على حسابه · CASH دفع فوري
  consumptionFee    Float    @default(0)
  feeSettlement     String?
  feeMethodId       String?
  feeCashAccountId  String?
  notes             String?
  createdAt         DateTime @default(now())

  purchaseInvoice PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id])
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  lines           PurchaseReturnLine[]
}

model PurchaseReturnLine {
  id           String @id @default(cuid())
  returnId     String
  productId    String
  quantity     Float
  unitCost     Float
  total        Float
  /// كمية تم استلامها تاني بعد المرتجع في مخزن جديد
  restockedQty Float  @default(0)

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
}

/// بطارية قديمة دخلت المحل (خردة من فاتورة بيع / ضمان زبون / يدوي).
/// بتتفرز بالليل: خردة · مستعمل · سيرفس · مرتجع ضمان للمورد
model OldBattery {
  id                     String    @id @default(cuid())
  number                 String    @unique
  source                 String
  ownership              String    @default("SHOP")
  productId              String?
  label                  String?
  salesInvoiceId         String?
  salesReturnId          String?
  customerId             String?
  customerName           String?
  customerPhone          String?
  intakeValue            Float     @default(0)
  receivedAt             DateTime  @default(now())
  productionDate         DateTime?
  ageBand                String?
  condition              String?
  decision               String    @default("PENDING")
  sortedAt               DateTime?
  stockProductId         String?
  stockWarehouseId       String?
  weightKg               Float?
  scrapSaleId            String?
  supplierId             String?
  claimStatus            String?
  sentAt                 DateTime?
  receiverName           String?
  replacementAt          DateTime?
  replacementProductId   String?
  replacementWarehouseId String?
  /// بطارية سيرفس/مستعمل اتسلّمت للزبون مؤقتًا لحد ما ياخد البديل من المورد
  loanerProductId        String?
  loanerWarehouseId      String?
  loanerUnitCost         Float?
  loanerIssuedAt         DateTime?
  loanerReturnedAt       DateTime?
  consumptionFee         Float     @default(0)
  feeSettlement          String?
  feeMethodId            String?
  feeCashAccountId       String?
  deliveredAt            DateTime?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  product              Product?      @relation("OldBatteryProduct", fields: [productId], references: [id], onDelete: SetNull)
  stockProduct         Product?      @relation("OldBatteryStockProduct", fields: [stockProductId], references: [id], onDelete: SetNull)
  replacementProduct   Product?      @relation("OldBatteryReplacementProduct", fields: [replacementProductId], references: [id], onDelete: SetNull)
  loanerProduct        Product?      @relation("OldBatteryLoanerProduct", fields: [loanerProductId], references: [id], onDelete: SetNull)
  stockWarehouse       Warehouse?    @relation("OldBatteryStockWarehouse", fields: [stockWarehouseId], references: [id], onDelete: SetNull)
  replacementWarehouse Warehouse?    @relation("OldBatteryReplacementWarehouse", fields: [replacementWarehouseId], references: [id], onDelete: SetNull)
  loanerWarehouse      Warehouse?    @relation("OldBatteryLoanerWarehouse", fields: [loanerWarehouseId], references: [id], onDelete: SetNull)
  salesInvoice         SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  salesReturn          SalesReturn?  @relation(fields: [salesReturnId], references: [id], onDelete: SetNull)
  customer             Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier             Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  scrapSale            ScrapSale?    @relation(fields: [scrapSaleId], references: [id], onDelete: SetNull)

  @@index([decision])
  @@index([claimStatus])
  @@index([supplierId])
  @@index([salesInvoiceId])
  @@index([salesReturnId])
}

/// بيع خردة بالوزن لمورد. بمياه = خصم نسبة من الوزن.
/// التسوية: INVOICE خصم من فاتورة شراء · CASH استلام فلوس · BALANCE خصم من حساب المورد
model ScrapSale {
  id                String   @id @default(cuid())
  number            String   @unique
  supplierId        String
  saleDate          DateTime @default(now())
  withWater         Boolean  @default(false)
  waterPercent      Float    @default(15)
  grossKg           Float
  netKg             Float
  priceKg           Float
  amount            Float
  settlement        String
  purchaseInvoiceId String?  @unique
  cashAccountId     String?
  paymentMethod     String   @default("")
  notes             String?
  createdAt         DateTime @default(now())

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  cashAccount     CashAccount?     @relation(fields: [cashAccountId], references: [id])
  oldBatteries    OldBattery[]

  @@index([supplierId])
  @@index([saleDate])
}

model Payment {
  id                String   @id @default(cuid())
  number            String   @unique
  supplierId        String
  cashAccountId     String?
  purchaseInvoiceId String?
  amount            Float
  paymentMethod     String   @default("")
  referenceNo       String?
  note              String?
  paidAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  cashAccount     CashAccount?     @relation(fields: [cashAccountId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
}

model Receipt {
  id             String   @id @default(cuid())
  number         String   @unique
  customerId     String
  cashAccountId  String?
  salesInvoiceId String?
  amount         Float
  paymentMethod  String   @default("")
  referenceNo    String?
  note           String?
  shiftId        String?
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id])
  cashAccount  CashAccount?  @relation(fields: [cashAccountId], references: [id])
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  shift        CashierShift? @relation(fields: [shiftId], references: [id])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

enum PeriodAction {
  CLOSE
  REOPEN
}

model FiscalPeriod {
  id         String    @id @default(cuid())
  year       Int
  month      Int
  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("PeriodClosedBy", fields: [closedById], references: [id])

  @@unique([year, month])
}

model FiscalPeriodLog {
  id        String       @id @default(cuid())
  year      Int
  month     Int
  action    PeriodAction
  reason    String?
  userId    String
  user      User         @relation("PeriodLogUser", fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([year, month])
}

model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String   @unique
  scope      String
  userId     String   @default("")
  resourceId String   @default("")
  createdAt  DateTime @default(now())
}

model Sequence {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model CustomerPrice {
  id         String @id @default(cuid())
  customerId String
  productId  String
  price      Float

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model WarehouseLocation {
  id          String @id @default(cuid())
  warehouseId String
  code        String
  name        String

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  products  ProductLocation[]

  @@unique([warehouseId, code])
}

model ProductLocation {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  locationId  String

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location  WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

model UserWarehouse {
  userId      String
  warehouseId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
}

model CashierShift {
  id            String      @id @default(cuid())
  userId        String
  cashAccountId String
  status        ShiftStatus @default(OPEN)
  openingCash   Float
  closingCash   Float?
  expectedCash  Float?
  difference    Float?
  notes         String?
  openedAt      DateTime    @default(now())
  closedAt      DateTime?

  user     User           @relation(fields: [userId], references: [id])
  account  CashAccount    @relation(fields: [cashAccountId], references: [id])
  invoices SalesInvoice[]
  receipts Receipt[]
  expenses Expense[]
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]
}

/// سجل الأصول الثابتة — مجموع قيمها = رأس مال الشركة المسجّل
model FixedAsset {
  id                   String    @id @default(cuid())
  name                 String
  value                Float
  acquiredAt           DateTime  @default(now())
  notes                String?
  isActive             Boolean   @default(true)
  category             String?
  usefulLifeMonths     Int?
  residualValue        Float     @default(0)
  depreciationMethod   String    @default("STRAIGHT_LINE")
  accumulatedDepreciation Float  @default(0)
  glAccountId          String?
  accumDepAccountId    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  glAccount       Account? @relation("FixedAssetGl", fields: [glAccountId], references: [id], onDelete: SetNull)
  accumDepAccount Account? @relation("FixedAssetAccumDep", fields: [accumDepAccountId], references: [id], onDelete: SetNull)
  depEntries      FixedAssetDepreciation[]

  @@index([isActive])
  @@index([acquiredAt])
}

model Expense {
  id            String   @id @default(cuid())
  categoryId    String
  accountId     String
  shiftId       String?
  amount        Float
  expenseDate   DateTime @default(now())
  paymentMethod String   @default("")
  notes         String?
  createdAt     DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  account  CashAccount     @relation(fields: [accountId], references: [id])
  shift    CashierShift?   @relation(fields: [shiftId], references: [id])
}

model BankCheck {
  id                String         @id @default(cuid())
  direction         CheckDirection
  checkNumber       String
  bankName          String
  amount            Float
  issueDate         DateTime       @default(now())
  dueDate           DateTime
  status            CheckStatus    @default(PENDING)
  customerId        String?
  supplierId        String?
  accountId         String?
  salesInvoiceId    String?
  purchaseInvoiceId String?
  methodId          String?
  receiptId         String?
  paymentId         String?
  notes             String?
  createdAt         DateTime       @default(now())

  customer Customer?    @relation(fields: [customerId], references: [id])
  supplier Supplier?    @relation(fields: [supplierId], references: [id])
  account  CashAccount? @relation(fields: [accountId], references: [id])
}

model TradeDocument {
  id          String    @id @default(cuid())
  kind        DocKind
  number      String    @unique
  status      DocStatus @default(DRAFT)
  customerId  String?
  supplierId  String?
  warehouseId String?
  docDate     DateTime  @default(now())
  notes       String?
  discount    Float     @default(0)
  taxRate     Float     @default(0)
  total       Float     @default(0)
  convertedId String?
  createdAt   DateTime  @default(now())

  customer  Customer?           @relation("DocCustomer", fields: [customerId], references: [id])
  supplier  Supplier?           @relation("DocSupplier", fields: [supplierId], references: [id])
  warehouse Warehouse?          @relation(fields: [warehouseId], references: [id])
  lines     TradeDocumentLine[]
}

model TradeDocumentLine {
  id         String @id @default(cuid())
  documentId String
  productId  String
  quantity   Float
  unitPrice  Float
  discount   Float  @default(0)
  total      Float

  document TradeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  method    String
  path      String
  status    String   @default("success")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model AppNotification {
  id        String    @id @default(cuid())
  dedupeKey String    @unique
  category  String
  title     String
  body      String
  severity  String    @default("info")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt])
}

enum OrgKind {
  ADMINISTRATION
  DEPARTMENT
  JOB_TITLE
  STAFF_GROUP
}

model OrgNode {
  id        String   @id @default(cuid())
  kind      OrgKind
  name      String
  code      String?
  subtitle  String?
  levelMark String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   OrgNode?  @relation("OrgParent", fields: [parentId], references: [id])
  children OrgNode[] @relation("OrgParent")
  members  User[]

  @@index([kind])
}

model RecordNote {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  body       String
  userId     String?
  userName   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  APPROVED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model WorkTask {
  id            String        @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus    @default(PENDING)
  priority      TaskPriority  @default(MEDIUM)
  assigneeId    String?
  assigneeName  String?
  dueDate       DateTime?
  entityType    String?
  entityId      String?
  entityLabel   String?
  createdById   String?
  createdByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  comments      TaskComment[]

  @@index([status])
  @@index([assigneeId])
  @@index([entityType, entityId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  body      String
  userId    String?
  userName  String?
  createdAt DateTime @default(now())
  task      WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model SavedReport {
  id         String   @id @default(cuid())
  name       String
  definition String
  ownerId    String?
  ownerName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}

model SavedView {
  id        String   @id @default(cuid())
  name      String
  module    String
  query     String
  ownerId   String
  ownerName String?
  createdAt DateTime @default(now())

  @@index([module, ownerId])
}

model Attachment {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  fileName       String
  mimeType       String
  size           Int
  storageName    String
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
}

/// File contents (product images, attachments) so uploads survive hosts with ephemeral disks.
model FileBlob {
  key       String   @id
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model AutomationRule {
  id        String          @id @default(cuid())
  name      String
  trigger   String
  action    String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  runs      AutomationRun[]
}

model AutomationRun {
  id        String         @id @default(cuid())
  ruleId    String
  dedupeKey String         @unique
  summary   String
  createdAt DateTime       @default(now())
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

enum HrLeaveType {
  ANNUAL
  SICK
  UNPAID
  PERMISSION
  OTHER
}

enum HrMovementKind {
  ADVANCE
  BONUS
  DEDUCTION
}

enum HrRequestKind {
  LEAVE
  ADVANCE
  PERMISSION
}

enum HrRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HrAttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
  WEEKEND
}

enum PayrollStatus {
  DRAFT
  POSTED
  PAID
}

model Employee {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String
  phone             String?
  nationalId        String?
  jobTitle          String?
  department        String?
  hireDate          DateTime?
  basicSalary       Float     @default(0)
  commissionPercent Float     @default(0)
  userId            String?   @unique
  bankAccount       String?
  notes             String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances        Attendance[]
  missions           AttendanceMission[]
  leaves             HrLeave[]
  movements          HrMovement[]
  requests           HrRequest[]
  payrollLines       PayrollLine[]
  commissionPayments HrCommissionPayment[]
}

model HrSettings {
  id                  String @id @default("default")
  workStart           String @default("09:00")
  workEnd             String @default("17:00")
  graceMinutes        Int    @default(15)
  monthWorkDays       Int    @default(30)
  weekendDays         String @default("[6]")
  lateDeductPerMinute Float  @default(0)
}

model HrHoliday {
  id     String   @id @default(cuid())
  date   DateTime
  name   String
  yearly Boolean  @default(false)

  @@index([date])
}

model Attendance {
  id          String              @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      HrAttendanceStatus  @default(PRESENT)
  lateMinutes Int                 @default(0)
  notes       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
}

model AttendanceMission {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  leftAt     DateTime
  returnedAt DateTime?
  purpose    String
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

model HrLeave {
  id         String      @id @default(cuid())
  employeeId String
  type       HrLeaveType
  fromDate   DateTime
  toDate     DateTime
  hours      Float       @default(0)
  notes      String?
  createdAt  DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, fromDate, toDate])
}

model HrMovement {
  id           String         @id @default(cuid())
  employeeId   String
  kind         HrMovementKind
  amount       Float
  movementDate DateTime
  notes        String?
  payrollRunId String?
  settled      Boolean        @default(false)
  createdAt    DateTime       @default(now())

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@index([employeeId, movementDate])
  @@index([settled])
}

model HrRequest {
  id             String          @id @default(cuid())
  employeeId     String
  kind           HrRequestKind
  status         HrRequestStatus @default(PENDING)
  leaveType      HrLeaveType?
  fromDate       DateTime?
  toDate         DateTime?
  hours          Float           @default(0)
  amount         Float           @default(0)
  reason         String?
  notes          String?
  requestedById  String?
  deductHours    Float?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  rejectReason   String?
  leaveId        String?
  movementId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([status, createdAt])
}

model PayrollRun {
  id          String        @id @default(cuid())
  fromDate    DateTime
  toDate      DateTime
  status      PayrollStatus @default(DRAFT)
  methodId    String?
  accountId   String?
  notes       String?
  postedAt    DateTime?
  postedById  String?
  /// Cumulative cash paid against this run (full payment only in v1)
  paidAmount  Float         @default(0)
  paidAt      DateTime?
  paidById    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines      PayrollLine[]
  movements  HrMovement[]
  commissions HrCommissionPayment[]

  @@index([fromDate, toDate])
  @@index([status])
}

model PayrollLine {
  id              String @id @default(cuid())
  payrollRunId    String
  employeeId      String
  basicSalary     Float  @default(0)
  dailyRate       Float  @default(0)
  presentDays     Float  @default(0)
  paidLeaveDays   Float  @default(0)
  permissionDays  Float  @default(0)
  unpaidDays      Float  @default(0)
  absentDays      Float  @default(0)
  lateMinutes     Int    @default(0)
  permissionHours Float  @default(0)
  earned          Float  @default(0)
  bonuses         Float  @default(0)
  deductions      Float  @default(0)
  advances        Float  @default(0)
  latePenalty     Float  @default(0)
  permissionDeduct Float @default(0)
  absenceDeduct   Float  @default(0)
  salaryNet       Float  @default(0)
  commissionDue   Float  @default(0)
  net             Float  @default(0)
  detailJson      String?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model HrCommissionPayment {
  id           String   @id @default(cuid())
  employeeId   String
  payrollRunId String?
  fromDate     DateTime
  toDate       DateTime
  salesTotal   Float    @default(0)
  percent      Float    @default(0)
  amount       Float
  notes        String?
  paidAt       DateTime @default(now())

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@index([employeeId, fromDate, toDate])
}

// ─────────────────────────────────────────────
// Accounting Foundation
// ─────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

enum AccountSubledger {
  NONE
  AR
  AP
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum AccountingEvent {
  SALE_CONFIRM
  SALE_RECEIPT
  SALE_COGS_ADJUST
  PURCHASE_CONFIRM
  PURCHASE_PAYMENT
  EXPENSE_CREATE
  SALE_RETURN
  PURCHASE_RETURN
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  CHECK_CLEAR_IN
  CHECK_CLEAR_OUT
  CHECK_BOUNCE_IN
  CHECK_BOUNCE_OUT
  PAYROLL_POST
  PAYROLL_PAYMENT
  SCRAP_SALE
  OPENING_BALANCE
  MANUAL
  DEPRECIATION
  MFG_MATERIAL_ISSUE
  MFG_WIP
  MFG_FINISHED_GOODS
}

enum AccountingPartyType {
  NONE
  CUSTOMER
  SUPPLIER
}

enum AccountingRole {
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  SALES_REVENUE
  SALES_TAX_PAYABLE
  SALES_DISCOUNT
  PURCHASE_DISCOUNT
  PURCHASE_TAX_RECEIVABLE
  COGS
  INVENTORY
  CASH
  BANK
  UNDEPOSITED_CHECKS
  CHECKS_PAYABLE
  EXPENSE
  PAYROLL_EXPENSE
  COMMISSION_EXPENSE
  SALARIES_PAYABLE
  SCRAP_REVENUE
  SCRAP_INVENTORY
  INVENTORY_ADJUSTMENT
  STOCK_TRANSFER_CLEARING
  SALES_RETURN_CLEARING
  PURCHASE_RETURN_CLEARING
  FIXED_ASSET
  ACCUMULATED_DEPRECIATION
  DEPRECIATION_EXPENSE
  OWNER_EQUITY
  OPENING_EQUITY
  RETAINED_EARNINGS
  OTHER
}

enum MappingSide {
  DEBIT
  CREDIT
}

enum AccountResolutionMode {
  FIXED
  CASH_ACCOUNT
  PAY_METHOD
}

enum MappingAmountSource {
  DOCUMENT_TOTAL
  DOCUMENT_SUBTOTAL
  DOCUMENT_DISCOUNT
  DOCUMENT_NET
  DOCUMENT_TAX
  DOCUMENT_SCRAP
  LINE_COGS_SUM
  COGS_DELTA
  TENDER_AMOUNT
  OPENING_ROW
  SCRAP_AMOUNT
  STOCK_VALUE
  FIXED_ASSET_VALUE
  SALARY_AMOUNT
  COMMISSION_AMOUNT
  CONTEXT
}

enum OpeningBatchStatus {
  DRAFT
  APPLIED
  REVERSED
}

enum AccountingPostQueueStatus {
  PENDING
  PROCESSING
  POSTED
  FAILED
  CANCELLED
}

model Account {
  id            String               @id @default(cuid())
  code          String               @unique
  name          String
  type          AccountType
  parentId      String?
  isPostable    Boolean              @default(true)
  isActive      Boolean              @default(true)
  cashAccountId String?              @unique
  normalBalance AccountNormalBalance @default(DEBIT)
  subledger     AccountSubledger     @default(NONE)
  sortOrder     Int                  @default(0)
  costCenterId  String?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Account[] @relation("AccountTree")

  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  journalLines     JournalLine[]
  mappingLines     AccountMappingLine[]
  openingBalances  AccountOpeningBalance[]
  fixedAssetsGl    FixedAsset[]            @relation("FixedAssetGl")
  fixedAssetsAccum FixedAsset[]            @relation("FixedAssetAccumDep")

  @@index([type])
  @@index([parentId])
  @@index([isActive])
  @@index([subledger])
  @@index([costCenterId])
}

model CostCenter {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  journalLines JournalLine[]
}

model JournalEntry {
  id              String             @id @default(cuid())
  number          String             @unique
  entryDate       DateTime
  description     String             @default("")
  status          JournalEntryStatus @default(DRAFT)
  sourceType      AccountingEvent    @default(MANUAL)
  sourceId        String?
  fiscalYear      Int
  fiscalMonth     Int
  createdById     String?
  reversesEntryId String?            @unique
  postedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  createdBy     User?         @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reversesEntry JournalEntry? @relation("JournalReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversalEntry JournalEntry? @relation("JournalReversal")

  lines           JournalLine[]
  openingBatch    AccountOpeningBatch?  @relation("OpeningBatchEntry")
  accountingQueue AccountingPostQueue?  @relation("QueuePostedEntry")

  @@unique([sourceType, sourceId])
  @@index([entryDate])
  @@index([status])
  @@index([fiscalYear, fiscalMonth])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id           String              @id @default(cuid())
  entryId      String
  accountId    String
  debit        Float               @default(0)
  credit       Float               @default(0)
  description  String?
  partyType    AccountingPartyType @default(NONE)
  customerId   String?
  supplierId   String?
  costCenterId String?
  lineOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())

  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier   Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costCenter CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@index([accountId])
  @@index([customerId])
  @@index([supplierId])
  @@index([costCenterId])
}

model AccountMapping {
  id        String          @id @default(cuid())
  event     AccountingEvent @unique
  isActive  Boolean         @default(true)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  lines AccountMappingLine[]
}

model AccountMappingLine {
  id             String                @id @default(cuid())
  mappingId      String
  role           AccountingRole
  side           MappingSide
  resolutionMode AccountResolutionMode @default(FIXED)
  amountSource   MappingAmountSource
  amountParam    Float?
  accountId      String?
  isRequired     Boolean               @default(true)
  lineOrder      Int                   @default(0)
  notes          String?

  mapping AccountMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  account Account?       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([mappingId, lineOrder])
  @@index([mappingId])
  @@index([accountId])
  @@index([role])
}

model AccountOpeningBatch {
  id             String             @id @default(cuid())
  fiscalYear     Int
  version        Int
  status         OpeningBatchStatus @default(DRAFT)
  journalEntryId String?            @unique
  /// When APPLIED: set to String(fiscalYear) to enforce one active batch per year
  appliedYearKey String?            @unique
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  journalEntry JournalEntry?           @relation("OpeningBatchEntry", fields: [journalEntryId], references: [id], onDelete: Restrict)
  lines        AccountOpeningBalance[]

  @@unique([fiscalYear, version])
  @@index([fiscalYear, status])
}

model AccountOpeningBalance {
  id         String              @id @default(cuid())
  batchId    String
  accountId  String
  debit      Float               @default(0)
  credit     Float               @default(0)
  partyType  AccountingPartyType @default(NONE)
  customerId String?
  supplierId String?
  partyKey   String              @default("NONE")
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  batch    AccountOpeningBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  account  Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([batchId, accountId, partyKey])
  @@index([batchId])
  @@index([accountId])
}

model AccountingPostQueue {
  id             String                     @id @default(cuid())
  event          AccountingEvent
  sourceId       String
  payload        String                     @default("{}")
  status         AccountingPostQueueStatus  @default(PENDING)
  attempts       Int                        @default(0)
  lastError      String?
  availableAt    DateTime                   @default(now())
  lockedBy       String?
  leaseExpiresAt DateTime?
  claimVersion   Int                        @default(0)
  postedEntryId  String?                    @unique
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  postedEntry JournalEntry? @relation("QueuePostedEntry", fields: [postedEntryId], references: [id], onDelete: Restrict)

  @@unique([event, sourceId])
  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
}

model FifoReplayEpoch {
  productId        String @id
  nextSeq          Int    @default(0)
  lastPublishedSeq Int    @default(0)
}

model AccountingCogsDirty {
  invoiceId   String   @id
  generation  Int
  targetCents Int?
  dirtyAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([dirtyAt])
}

model AccountingCogsLock {
  invoiceId      String    @id
  lockVersion    Int       @default(0)
  lockedBy       String?
  leaseExpiresAt DateTime?
  updatedAt      DateTime  @updatedAt

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model FixedAssetDepreciation {
  id            String   @id @default(cuid())
  fixedAssetId  String
  periodYear    Int
  periodMonth   Int
  amount        Float
  journalEntryId String?
  createdAt     DateTime @default(now())

  fixedAsset FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  @@unique([fixedAssetId, periodYear, periodMonth])
  @@index([fixedAssetId])
}

model AccountingAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  beforeJson String?
  afterJson  String?
  reason     String?
  createdAt  DateTime @default(now())

  user User? @relation("AccountingAuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}
